{
  "name": "fundermaps-worker",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "load-dataset": "bun run src/commands/load-dataset.ts",
    "ingest-dossier": "bun run src/commands/ingest-dossier.ts",
    "normalize-artifacts": "bun run src/commands/normalize-artifacts.ts",
    "load-loket-export": "bun run src/commands/load-loket-export.ts",
    "resolve-addresses": "bun run src/commands/resolve-addresses.ts",
    "check-qs-duplicates": "bun run src/commands/check-qs-duplicates.ts",
    "migrate": "bun run src/commands/migrate.ts",
    "test": "bun test",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
